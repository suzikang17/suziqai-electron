{
  "name": "suziqai",
  "version": "0.1.0",
  "description": "AI-assisted browser test authoring with Playwright",
  "main": "dist/main/main/main.js",
  "scripts": {
    "dev": "tsc -p tsconfig.main.json && concurrently \"vite\" \"tsc -p tsconfig.main.json --watch\" \"NODE_ENV=development electron .\"",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "build": "npm run build:renderer && npm run build:main",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "electron-builder",
    "ios-runner:build": "cd ios-runner && xcodegen generate && xcodebuild build-for-testing -project SuziQaiRunner.xcodeproj -scheme SuziQaiRunner -destination 'generic/platform=iOS Simulator' -derivedDataPath build CODE_SIGNING_ALLOWED=NO -quiet"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.296",
    "@anthropic-ai/claude-code": "^2.1.296",
    "@anthropic-ai/sdk": "^0.133.0",
    "@typesafe-ai/sdk": "^0.6.0",
    "electron": "^44.7.0",
    "ffmpeg-static": "^5.3.0",
    "lucide-react": "^1.55.0",
    "playwright": "^1.64.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "electron-builder": "^26.15.3",
    "jsdom": "^30.1.2",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
